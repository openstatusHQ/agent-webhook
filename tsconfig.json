{
    "compilerOptions": {
        "strict": true,
        "target": "esnext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "lib": ["esnext", "DOM"],
        "types": ["node"],
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
    },
}
