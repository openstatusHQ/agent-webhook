# OpenStatus instance the agent talks to (MCP is served at <url>/mcp)
OPENSTATUS_API_URL=https://api.openstatus.dev
# OpenStatus API key (sent as x-openstatus-key) — needs write scope
OPENSTATUS_API_KEY=
# Vercel AI Gateway key (routes the AGENT_MODEL string)
AI_GATEWAY_API_KEY=
# Model id resolved by the AI Gateway
AGENT_MODEL=anthropic/claude-haiku-4.5
# Shared secret expected in the inbound x-webhook-secret header
WEBHOOK_SECRET=
# true = never write to OpenStatus, only log the decision
DRY_RUN=true
PORT=3000
